# ================================================================
# 英語マスター 環境変数テンプレート
# cp .env.local.example .env.local  して値を入力してください
# .env.local は Git にコミットしない（.gitignore で除外済）
# ================================================================

# ── Supabase（必須 / 未設定時は localStorage で動作）────────────
# https://supabase.com → プロジェクト → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ── AI プロバイダー優先順位（未設定時は dummy で動作）───────────
# 順番にフォールバック: Groq→Cohere→Gemini→OpenAI→Dummy
AI_PROVIDER_PRIORITY=groq,cohere,gemini,openai,dummy

# Groq（推奨: 最速・無料枠大）https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Cohere（安価・JSON生成得意）https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...

# Google Gemini　https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI（最終手段）https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ================================================================
# Vercel デプロイ時
# Dashboard → Settings → Environment Variables に同じ値を設定
# NEXT_PUBLIC_ 変数: Production/Preview/Development 全てチェック
# APIキー類: Production のみ推奨
# ================================================================
